{
  "name": "relay-multi-agent",
  "version": "0.1.0",
  "description": "Local multi-agent peer review and consensus workspace",
  "author": "Relay",
  "private": true,
  "type": "module",
  "main": "dist-desktop/main.cjs",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "worker:local": "tsx src/local/worker.ts",
    "mcp:relay": "tsx src/local/relay-mcp-server.ts",
    "desktop:compile": "node scripts/build-desktop.mjs",
    "desktop:dev": "pnpm desktop:compile && electron .",
    "desktop:package": "pnpm build && pnpm desktop:compile && electron-builder --mac",
    "db:migrate": "tsx scripts/migrate.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@electric-sql/pglite-socket": "0.2.7",
    "@modelcontextprotocol/sdk": "1.30.0",
    "lucide-react": "1.28.0",
    "next": "16.2.12",
    "openid-client": "6.8.4",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "30.0.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
