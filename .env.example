DATABASE_URL=postgres://relay:relay@localhost:5432/relay
HOST_DATABASE_URL=postgres://relay:relay@127.0.0.1:5432/relay
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-bytes
CREDENTIAL_MASTER_KEY=replace-with-32-random-bytes-encoded-as-base64
AUTH_MODE=development
ALLOW_LOCAL_DEVELOPMENT_AUTH=true
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
CUSTOM_PROVIDER_HOSTS=
ALLOW_PRIVATE_PROVIDER_URLS=false
PROVIDER_REQUEST_TIMEOUT_MS=120000
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=750
JOB_LEASE_MS=180000
CODEX_BINARY=codex
RELAY_CODEX_CWD=/absolute/path/to/an/empty/relay-runtime
RELAY_LOCAL_AI_CWD=/absolute/path/to/an/empty/relay-runtime
RELAY_CODEX_SANDBOX=read-only
